# Copy this file to frontend/.env.local and fill in values.
# Only browser-safe values go here (NEXT_PUBLIC_*). Never put secret keys in the frontend.

# demo = synthetic KESTREL scenario (works with no keys) | live = read from Supabase + backend
NEXT_PUBLIC_DATA_MODE=demo

# Supabase → Project Settings → API (Project URL and the anon / publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Beacon Ops backend (FastAPI). Local default when you run the backend:
NEXT_PUBLIC_API_URL=

# Optional: your own MapLibre style URL (leave empty for free CARTO raster tiles)
NEXT_PUBLIC_MAP_STYLE_URL=
